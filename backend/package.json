{
  "name": "cal-hacks-backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "spacetime build --module-path .",
    "publish": "spacetime publish cal-hacks-ansingh --module-path . --server maincloud",
    "publish:reset": "spacetime publish cal-hacks-ansingh --module-path . --server maincloud --delete-data",
    "generate": "spacetime generate --yes --lang typescript --out-dir ../frontend/src/module_bindings --module-path .",
    "logs": "spacetime logs cal-hacks-ansingh --server maincloud",
    "publish:droid-test": "set -a && . ../.env && set +a && spacetime publish $SPACETIMEDB_DB_NAME --module-path . --server maincloud"
  },
  "dependencies": {
    "spacetimedb": "^2.13.0"
  },
  "devDependencies": {
    "typescript": "~5.6.2"
  }
}
