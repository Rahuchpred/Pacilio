    "label": {
      "size": 12,
      "line": 16,
      "weight": 500,
      "tracking": 0.02
    },
    "money": {
      "size": 15,
      "line": 22,
      "weight": 500,
      "tracking": 0,
      "family": "sans",
      "note": "Sans with tabular figures. Mono is only for IDs, keys, paths and code, at 0.8 size."
    }
  },
  "space": {
    "2xs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 48,
    "4xl": 64,
    "5xl": 96
