  "border": {
    "hairline": 1,
    "focus": 2
  },
  "elevation": {
    "flat": "none",
    "overlay": "0 0 0 1px",
    "paper": "0 0 0 1px rgb(31 26 20 / 0.05), 0 1px 2px rgb(31 26 20 / 0.05), 0 6px 16px -4px rgb(31 26 20 / 0.06), 0 18px 36px -14px rgb(31 26 20 / 0.10)",
    "paperDark": "0 0 0 1px rgb(255 255 255 / 0.07), 0 1px 2px rgb(0 0 0 / 0.4), 0 12px 28px -10px rgb(0 0 0 / 0.5)",
    "note": "White cards lift with paper: a near-invisible ring and two soft shadows in warm ink, never a colored outline. Overlays inside a card still use the 1px ring."
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "easeOut": "cubic-bezier(0.23, 1, 0.32, 1)",
    "easeInOut": "cubic-bezier(0.77, 0, 0.175, 1)"
