{
  "$name": "Pacioli",
  "$principle": "Ink and paper for money. The one action you press next is the only crafted surface.",
  "$sources": {
    "ramp.com": "near-black ink on white, one accent, 6px radius, no shadows, regular weights",
    "stripe.com": "light 300 display weight, negative tracking on headings, violet trust accent",
    "mercury.com": "dark mode built in, periwinkle accent, money set with small cents, provenance on every row"
  },
